################################################################################
### This file is generated by _update_spacy_recipe.py.  DO NOT EDIT BY HAND. ###
################################################################################

context:
  version: "<< version >>"
  # see https://github.com/explosion/spacy-models/blob/master/compatibility.json
  # but the pattern _generally_ seems to be x.x
  spacy_minor: ${{ (version | split(".") | list)[:2] | join(".") }}

recipe:
  name: spacy-models
  version: ${{ version }}

source:
  - url: https://raw.githubusercontent.com/explosion/spaCy/master/LICENSE
    sha256: 3f4378e67708fecacd3e27651c8bc0f977cf20789e19da0d81a2840e7cf573a2
<%- for lang, metas in lang_metas.items() %>
  - if: spacy_lang == "<< lang >>"
    then:
<%- for p, m in metas.items() %>
      - url: https://github.com/explosion/spacy-models/releases/download/<< m.lang >>_<< m.name >>-${{ version }}/<< m.lang >>_<< m.name >>-${{ version }}.tar.gz
        sha256: << m.checksum >>
        target_directory: << m.lang >>_<< m.name >>
<%- endfor %>
<%- endfor %>

build:
  number: << build_number >>
  noarch: python

outputs:
<%- for lang, metas in lang_metas.items() %>
<%- for p, m in metas.items() %>
  - package:
      name: spacy-model-<< m.lang >>_<< m.name >>
    build:
      noarch: python
      skip: spacy_lang != "<< m.lang >>"
      script:
        - cd << m.lang >>_<< m.name >>
        - ${PYTHON} ${RECIPE_DIR}/patch_meta.py
        - ${PYTHON} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check
    requirements:
      host:
        - pip
        - python ${{ python_min }}.*
        - setuptools
      run:
        - python >=${{ python_min }}
        - spacy ${{ spacy_minor }}.*
<%- for req in m.requirements %>
        - << reqtify(req) >>
<%- endfor %>
    tests:
      - python:
          imports:
            - << m.lang >>_<< m.name >>
          python_version: ${{ python_min }}.*
<%- if skip_pip_check.get(m.lang, {}).get(m.name) %>
          # TODO: fix pip check
          #       << skip_pip_check.get(m.lang, {}).get(m.name) >>
          pip_check: false
<%- endif %>
      - requirements:
          run:
            - python ${{ python_min }}.*
        script:
          - python -c "__import__('<< m.lang >>_<< m.name >>').load()"
          - python -c "__import__('spacy').load('<< m.lang >>_<< m.name >>')"
    about:
      summary: << m.description.split(". ", 1)[0].strip() >>.
      description: |-
        << m.description.split(". ", 1)[1].strip() >>
      license: MIT
      license_file:
        - << m.lang >>_<< m.name >>/LICENSE
        - << m.lang >>_<< m.name >>/LICENSES_SOURCES
<%- endfor %>
<%- endfor %>

about:
  homepage: https://spacy.io
  license: MIT
  license_file: LICENSE
  summary: Models for the spaCy Natural Language Processing (NLP) library
  documentation: https://spacy.io/models
  repository: << dev_url >>

extra:
  feedstock-name: spacy-models
  recipe-maintainers:
    - bollwyvl
